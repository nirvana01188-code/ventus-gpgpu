{
  "schema": "celviz.gpgpu.kernel_demo.v1",
  "ip_name": "Celviz GPGPU IP",
  "tier": "micro",
  "demo_lane": "E4 runtime CLI/kernel demo",
  "runtime_demo": {
    "dispatch_sequence": [
      "vadd",
      "gemm",
      "conv",
      "image_filter",
      "memcpy"
    ],
    "precision_modes": [
      "fp32",
      "fp16_proxy",
      "byte"
    ],
    "artifacts": [
      "dispatch_plan.json",
      "buffer_binds.json",
      "queue_trace.json",
      "golden_comparison.json",
      "hashes.json",
      "tier_scaling.json",
      "kernel_metrics.json",
      "summary.json"
    ],
    "claim_boundary": "clean-room OpenCL-like runtime demo; no proprietary Vivante command-stream, driver, firmware, SDK, or conformance claim"
  },
  "e1_runtime_abi_expectations": {
    "command_stream_fixture": "artifacts/rank_01_vivante_3d_gpgpu_ip/rtl/control_plane_demo.json",
    "runtime_cli_modes": [
      "kernel-demo",
      "commands-dry-run"
    ],
    "queue_lifecycle": {
      "queues_exercised": [
        "queue0",
        "queue1"
      ],
      "required_phases": [
        "submit",
        "wait",
        "readback"
      ],
      "status_expectation": "all queue_trace events complete with completion_status success"
    },
    "memory_paths": [
      "runtime memory_copy kernel",
      "control-plane host_to_device",
      "control-plane dma_fill",
      "control-plane dma_copy",
      "control-plane device_to_host"
    ],
    "negative_paths": [
      "expected scheduler fault",
      "expected MMU fault",
      "expected named fence timeout"
    ]
  },
